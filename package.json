{
  "name": "koodex",
  "productName": "Koodex",
  "version": "2.0.0",
  "private": true,
  "description": "A quiet Codex and Claude Code usage companion for Windows",
  "author": "cimanesdev",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:web": "vite build",
    "build": "tauri build",
    "release": "tauri build && node scripts/checksums.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "tsx --test tests/*.test.ts",
    "build:site": "node scripts/build-site.mjs",
    "memory": "powershell -ExecutionPolicy Bypass -File scripts/memory.ps1",
    "format": "prettier --write src scripts tests package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "type": "module"
}
